#!/usr/bin/env bash
input=$(cat)
if [ -z "$input" ] || ! echo "$input" | jq empty 2>/dev/null; then
  echo '{"ok":false,"error":{"type":"invalid_input","message":"Expected JSON on stdin. Provide '\''{}'\'' for tools with no arguments."}}'
  exit 0
fi

echo "{\"ok\":true,\"result\":{\"iso\":\"$(date -u +%Y-%m-%dT%H:%M:%S.000Z)\",\"local\":\"$(date)\",\"dayName\":\"$(date +%A)\",\"datePretty\":\"$(date '+%A, %B %d, %Y')\",\"timestamp\":$(date +%s%3N),\"timeZone\":\"$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone)\",\"utcOffset\":\"$(date +%:z)\"}}"
